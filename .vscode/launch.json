{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PM Assistant (terminale integrato)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/pm-assistant/bin/Debug/net8.0/pm-assistant.dll",
      "args": [],
      "cwd": "${workspaceFolder}/pm-assistant",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Server avviato su (https?://\\S+)",
        "uriFormat": "%s/api/health"
      }
    },
    {
      "name": "PM Assistant (console esterna)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/pm-assistant/bin/Debug/net8.0/pm-assistant.dll",
      "args": [],
      "cwd": "${workspaceFolder}/pm-assistant",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Attach a processo",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "name": "Ore Tracking - Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-ore-api",
      "program": "${workspaceFolder}/ore-tracking/Api/bin/Debug/net8.0/OreTracking.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ore-tracking/Api",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "pattern": "Now listening on: http://localhost:(?<port>\\d+)",
        "uriFormat": "http://localhost:{port}/swagger",
        "action": "openExternally"
      }
    },
    {
      "name": "Ore Tracking - Frontend (Angular)",
      "type": "node-terminal",
      "request": "launch",
      "command": "ng serve",
      "cwd": "${workspaceFolder}/ore-tracking/Web",
      "serverReadyAction": {
        "pattern": "Local: http://localhost:(?<port>\\d+)",
        "uriFormat": "http://localhost:{port}",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Ore Tracking - Backend + Frontend",
      "configurations": ["Ore Tracking - Backend (.NET)", "Ore Tracking - Frontend (Angular)"],
      "preLaunchTask": "build-ore-api"
    }
  ]
}
