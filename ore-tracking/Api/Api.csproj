<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OreTracking.Api</AssemblyName>
    <RootNamespace>OreTracking.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.28" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.28">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.28" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.28" />
  </ItemGroup>

  <!-- Percorso frontend -->
  <PropertyGroup>
    <FrontendRoot>$(MSBuildThisFileDirectory)..\Web</FrontendRoot>
    <FrontendDist>$(FrontendRoot)\dist\ore-web\browser</FrontendDist>
  </PropertyGroup>

  <!-- Pre-build: compila Angular prima di build/publish .NET -->
  <Target Name="BuildFrontend" BeforeTargets="Build;Publish" Condition="'$(BuildingInsideVisualStudio)' != 'true'">
    <Message Text="Building Angular frontend..." Importance="high" />
    <Exec Command="&quot;$(MSBuildThisFileDirectory)build-frontend.bat&quot;" />
    <ItemGroup>
      <_FrontendFiles Include="$(FrontendDist)\**\*" />
    </ItemGroup>
  </Target>

  <!-- Copia il frontend nella cartella wwwroot -->
  <Target Name="CopyFrontendToWwwroot" BeforeTargets="Build;Publish">
    <MakeDir Directories="$(MSBuildThisFileDirectory)wwwroot" Condition="!Exists('$(MSBuildThisFileDirectory)wwwroot')" />
    <Copy SourceFiles="@(_FrontendFiles)" DestinationFiles="$(MSBuildThisFileDirectory)wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>

  <!-- Includi wwwroot nel publish -->
  <ItemGroup>
    <None Include="wwwroot\**\*" Pack="true" PackagePath="wwwroot" Condition="Exists('wwwroot')" />
  </ItemGroup>

</Project>
